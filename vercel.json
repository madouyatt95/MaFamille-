{
  "rewrites": [
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/decouvrir",
      "destination": "/index.html"
    },
    {
      "source": "/decouvrir/",
      "destination": "/index.html"
    },
    {
      "source": "/quick-micro",
      "destination": "/index.html"
    },
    {
      "source": "/quick-micro/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/quick-expense",
      "destination": "/index.html"
    },
    {
      "source": "/quick-expense/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/action/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/share/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/share-target/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
